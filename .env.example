# ==============================================================================
# CampusConnect — Environment Configuration Template
# Never commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:8080
# OAuth 2.0 Web Client ID from Google Cloud Console (must match the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
VITE_SOCKET_URL=http://localhost:5000
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
VITE_MAX_UPLOAD_MB=10

# Google OAuth Client ID for Google Identity Services (One Tap / Sign-In button)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Backend Spring Boot Environment Variables
# ------------------------------------------------------------------------------
# Database Connection (Defaults to MySQL in production; H2 in-memory in dev fallback)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusconnect?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# JWT Security (Must be minimum 256-bit / 32-character secret)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Frontend Base URL & Redirects
CAMPUSCONNECT_FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 & Google Calendar / Meet Integration
# Requires Google Cloud project with Google Calendar API enabled.
# Authorized Redirect URI: http://localhost:3000/calendar
# Authorized JavaScript Origins: http://localhost:3000, http://localhost:3001
CAMPUSCONNECT_GOOGLE_CLIENT_ID=
CAMPUSCONNECT_GOOGLE_CLIENT_SECRET=

# Real SMTP Email Delivery (Gmail / University SMTP / SendGrid)
# When set to true and credentials provided, delivers authentic notification emails
CAMPUSCONNECT_MAIL_ENABLED=false
CAMPUSCONNECT_MAIL_FROM=noreply@campusconnect.edu
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
